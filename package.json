{
  "name": "vanilla-signal-query",
  "version": "1.1.6",
  "private": false,
  "description": "An asynchronous data fetching and server state management library designed for vanilla JavaScript applications.",
  "keywords": [
    "fetch",
    "query",
    "signal",
    "vanilla"
  ],
  "homepage": "https://github.com/WangShai123/vanilla-query",
  "bugs": {
    "url": "https://github.com/WangShai123/vanilla-query/issues"
  },
  "license": "ISC",
  "author": "Wang Shai <hiwangshai@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WangShai123/vanilla-query.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "pack": "vp check --fix && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "vanilla-create-storage": "^1.0.4",
    "vanilla-signal": "^1.1.15",
    "vanilla-simple-lru": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  }
}
